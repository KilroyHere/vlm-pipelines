{
  "$defs": {
    "AgainstWall": {
      "description": "a's back (local -Y side) is within ``max_gap`` of a wall (any wall, or ``wall_id``).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "hard": {
          "default": false,
          "title": "Hard",
          "type": "boolean"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "origin": {
          "default": "user",
          "enum": [
            "rule_library",
            "user",
            "vlm"
          ],
          "title": "Origin",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "type": {
          "const": "against_wall",
          "default": "against_wall",
          "title": "Type",
          "type": "string"
        },
        "a": {
          "title": "A",
          "type": "string"
        },
        "wall_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Id"
        },
        "max_gap": {
          "default": 0.05,
          "minimum": 0,
          "title": "Max Gap",
          "type": "number"
        }
      },
      "required": [
        "id",
        "a"
      ],
      "title": "AgainstWall",
      "type": "object"
    },
